\definecolor{cvcyan}{HTML}{C9F2FF}
\definecolor{cvaccent}{HTML}{11A8D8}
\definecolor{cvmuted}{HTML}{4F5D73}
\definecolor{cvline}{HTML}{A8B4C5}
\definecolor{cvtag}{HTML}{F7FCFF}

\hypersetup{
  colorlinks=true,
  urlcolor=cvnavy,
  linkcolor=cvnavy,
  pdfauthor={Eduardo Guevara},
  pdftitle={Curriculum Vitae - Eduardo Guevara},
